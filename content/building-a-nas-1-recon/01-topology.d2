# layout: dagre
...@classes

direction: down

cpu: Intel Core i5-6600T\n16 PCIe 3.0 lanes {class: ours}
pch: B250 chipset (PCH) {class: box}

asm2824: ASM2824 switch\nPCIe 3.0, x8 up, 4 × x4 down {class: ours}
nvme: 2 × 1 TB NVMe\nZFS mirror, fast data\n+ 2 slots free {class: box}

sfp: M.2 → SFP+ adapter\nIntel 82599, PCIe 2.0 x4\n10 Gbit needs ~1.25 GB/s {class: ours}

asm1182e: ASM1182e switch\nPCIe 2.0 x1 → 2 × M.2\n2 × 256 GB NVMe, ZFS mirror, OS {class: spof}

sata: 6 × SATA 6 Gb/s {
  class: grp
  style.font-size: 16
  grid-columns: 1
  grid-gap: 12
  tank: 3 × IronWolf 6 TB\nraidz1, 12 TB usable {class: box}
  copy: 2 × Barracuda 6 TB\nstripe, warm copy {class: box}
  free: 1 port free {class: drawer}
}

cpu -> asm2824: "x16 slot, x8 used, ~7.9 GB/s" {style.stroke: "#98bb6c"}
asm2824 -> nvme: "4 × PCIe 3.0 x4" {style.stroke: "#98bb6c"}

cpu -> pch: "DMI 3.0 x4, ~3.9 GB/s, shared by all below" {style.stroke: "#727169"}

pch -> sfp: "M.2 slot, links at 2.0 x4, ~2 GB/s" {style.stroke: "#98bb6c"}

pch -> asm1182e: "x1 slot, links at 2.0, ~500 MB/s" {style.stroke: "#d27e99"}

pch -> sata: "" {style.stroke: "#727169"}
