# layout: dagre
...@classes

direction: down

# 18px labels. The prose column is 825px on desktop and the browser scales
# the SVG down to it, font with it: 1007px wide renders labels at ~14.5px
# against 13.6px prose. Every extra 100px of width costs ~1.4px of label.
# dagre lays edge labels out as nodes of their own rank, so a long label
# pushes the columns apart: keep every line short.
*.style.font-size: 18
**.style.font-size: 18
(* -> *)[*].style.font-size: 18

cpu: Intel Core i5-6600T\n16 PCIe 3.0 lanes {class: ours}
pch: B250 chipset (PCH) {class: box}

asm2824: ASM2824 switch\nPCIe 3.0, x8 up\n4 × x4 down {class: ours}
nvme: 2 × 1 TB NVMe\nZFS mirror, fast\n+ 2 slots free {class: box}

sfp: M.2 → SFP+ adapter\nIntel 82599\nPCIe 2.0 x4 {class: ours}

asm1182e: ASM1182e switch\nx1 → 2 × M.2\n2 × 256 GB NVMe\nZFS mirror, OS {class: spof}

sata: 6 × SATA 6 Gb/s {
  class: grp
  grid-columns: 1
  grid-gap: 12
  tank: 3 × IronWolf 6 TB\nraidz1 → 12 TB {class: box}
  copy: 2 × Barracuda 6 TB\nstripe, warm copy {class: box}
  free: 1 port free {class: drawer}
}

cpu -> asm2824: "x16 slot, x8 used\n~7.9 GB/s" {style.stroke: "#98bb6c"}
asm2824 -> nvme: "4 × PCIe 3.0 x4" {style.stroke: "#98bb6c"}

cpu -> pch: "DMI 3.0 x4\n~3.9 GB/s, shared" {style.stroke: "#727169"}

pch -> sfp: "M.2 slot, at 2.0 x4\n~2 GB/s; 10 Gbit\nneeds ~1.25 GB/s" {style.stroke: "#98bb6c"}

pch -> asm1182e: "x1 slot, at 2.0\n~500 MB/s" {style.stroke: "#d27e99"}

pch -> sata: "" {style.stroke: "#727169"}
